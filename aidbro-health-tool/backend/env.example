# ─── Google APIs ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_places_pagespeed_key

# ─── Google OAuth (for client portal login) ───────────────────────────────────
# Get from: console.cloud.google.com → Credentials → OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ─── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:aidbro2026@localhost:5432/aidbro_db

# ─── Payment ──────────────────────────────────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
# Test mode: rzp_test_...  |  Live mode: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Detailed audit price in rupees (e.g. 2000 = ₹2,000)
AUDIT_PRICE_INR=2000

# How many days portal access lasts after payment
PORTAL_ACCESS_DAYS=90

# Audit credit purchase price — one purchase grants AUDIT_CREDITS_PER_PURCHASE audits
AUDIT_CREDIT_PRICE_INR=299
AUDIT_CREDITS_PER_PURCHASE=2

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=generate_a_random_32_char_string_here
ADMIN_JWT_SECRET=generate_a_different_random_string_here
JWT_EXPIRES_DAYS=7
PASSWORD_HASH_ITERATIONS=390000

# ─── App Config ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Only required in production
SENTRY_DSN=
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ADMIN_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
